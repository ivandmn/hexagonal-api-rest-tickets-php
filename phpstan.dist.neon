parameters:
    level: 10
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony (config reference for IDEs); its classes live in the cache.
        - config/reference.php
    ignoreErrors:
        # Functional tests read decoded JSON bodies, which are `mixed` by nature: the assertions
        # themselves check the shape, and a wrong access fails the test at runtime anyway.
        -
            identifiers: [offsetAccess.nonOffsetAccessible, argument.type]
            paths: [tests/Functional/*, tests/Unit/UI/Http/Exception/ApiExceptionListenerTest.php]
        -
            identifier: binaryOp.invalid
            path: tests/Functional/*
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0
    symfony:
        # Same environment as tests/Support/PhpStan/Kernel.php (`make phpstan` warms it up)
        containerXmlPath: var/cache/test/App_Infrastructure_Symfony_KernelTestDebugContainer.xml
        consoleApplicationLoader: tests/Support/PhpStan/ConsoleApplication.php
    doctrine:
        objectManagerLoader: tests/Support/PhpStan/DoctrineObjectManager.php

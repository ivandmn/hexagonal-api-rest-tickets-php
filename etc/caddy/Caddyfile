{
	skip_install_trust

	# Explicit: local only, never reachable from the network.
	admin localhost:2019

	servers {
		# Traefik sits in front: log the client's IP from X-Forwarded-For, not Traefik's.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		worker {
			file /web/public/index.php
			# Each worker holds a full app in memory: workers × memory_limit must fit the container.
			num {$FRANKENPHP_NUM_WORKERS:4}
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter / header
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}
	# The Docker healthcheck calls it every 30 s: it would be most of the access log.
	log_skip /health

	root /web/public
	encode zstd br gzip

	# A JSON API: cut oversized bodies here, before they reach PHP.
	request_body {
		max_size 2MB
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	# Forced (no `?`): the app never needs to relax them. HSTS goes in Traefik, which terminates TLS.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		?Permissions-Policy "browsing-topics=()"
		-X-Powered-By
		-Server
	}

	@immutableAssets path /build/* /assets/*
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController

	file_server {
		hide *.php
	}
}

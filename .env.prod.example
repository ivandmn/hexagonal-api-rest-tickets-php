# Variables for Dokploy's "Environment" tab (not a file used locally).
# Dokploy writes them to a .env next to docker-compose.yml: compose interpolates EXTERNAL_NET from it
# and the service receives everything through env_file.
#
# Already baked into the prod image (override here only if needed):
#   APP_ENV=prod  APP_DEBUG=0  SERVER_NAME=:80  TRUSTED_PROXIES=private_ranges

# Docker network shared with Traefik and the database
EXTERNAL_NET=dokploy-network

# Generate a new one: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=CHANGE_ME

DEFAULT_URI=https://api.your-domain.com

# Internal host of the Dokploy Postgres service ("Internal Credentials" tab), never its public port.
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23...).
DATABASE_URL="postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DB_NAME?serverVersion=18&charset=utf8"

# Run pending migrations (creating the "tickets" schema if needed) every time the container starts
RUN_MIGRATIONS=true

# Optional: enables /info behind HTTP Basic Auth. Leave INFO_PASSWORD unset to keep it hidden (404).
INFO_USER=admin
INFO_PASSWORD=CHANGE_ME

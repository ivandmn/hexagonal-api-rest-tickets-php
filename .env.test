KERNEL_CLASS='App\Infrastructure\Symfony\Kernel'
APP_ENV=test
APP_DEBUG=1
APP_SECRET='$ecretf0rt3st'

DEFAULT_URI=http://localhost

###> doctrine/doctrine-bundle ###
# Throwaway database of the infrastructure repo (docker-postgres-test): `make test-db` creates the
# schema. CI overrides it with its own service. See config/packages/doctrine.yaml.
DB_TEST_NAME=postgres_test
DB_TEST_USER=admin
DB_TEST_PASSWORD=your_db_password_here
DB_TEST_HOST=app-postgres-test
DB_TEST_PORT=5432
TEST_DATABASE_URL="postgresql://${DB_TEST_USER}:${DB_TEST_PASSWORD}@${DB_TEST_HOST}:${DB_TEST_PORT}/${DB_TEST_NAME}?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

KERNEL_CLASS='App\Infrastructure\Symfony\Kernel'
APP_ENV=test
APP_DEBUG=1
APP_SECRET='$ecretf0rt3st'

DEFAULT_URI=http://localhost

# Throwaway database of the dev stack (service "tickets-db-test", data in tmpfs): `make test-db`
# creates the schema. CI overrides it with its own service. See config/packages/doctrine.yaml.
TEST_DATABASE_URL="postgresql://app:app@tickets-db-test:5432/tickets_test?serverVersion=18&charset=utf8"
